# Arch Linux package for 3D BuildCraft, built from the release tag's source tarball.
# packaging/arch/build-pkg.sh builds the same package from the local checkout instead.
# After bumping pkgver for a published tag, run updpkgsums to fill in the checksum.
pkgname=buildcraft3d
pkgver=0.1.17
pkgrel=1
pkgdesc='Build, repair and prepare 3D models for printing'
arch=('x86_64')
url='https://github.com/Nico2433/3D-BuildCraft'
license=('MIT')
# Linked: glibc, libgcc, libstdc++, dbus (keychain). Loaded at run time with dlopen:
# Vulkan or EGL for wgpu, and the X11/Wayland/xkbcommon libraries for winit.
depends=(
  'dbus'
  'glibc'
  'hicolor-icon-theme'
  'libgcc'
  'libglvnd'
  'libstdc++'
  'libx11'
  'libxcursor'
  'libxi'
  'libxkbcommon'
  'libxkbcommon-x11'
  'vulkan-icd-loader'
  'wayland'
)
# clang: libclang for the webcam crate's v4l2 bindings (bindgen).
makedepends=('cargo' 'clang')
optdepends=(
  'xdg-desktop-portal: file dialogs and printing (with a backend such as xdg-desktop-portal-gtk or -kde)'
  'org.freedesktop.secrets: keep AI assistant API keys in the keychain'
)
# Thin LTO comes from Cargo.toml; makepkg's C-level LTO flags break the C/C++ crates.
options=('!lto')
_id=io.github.nico2433.BuildCraft3D
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('a3707eb9c072efa6536e426ab0ddc1c836f9c4303f8ba4bbd99fb40708f6b5b8')

prepare() {
  cd "3D-BuildCraft-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "3D-BuildCraft-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "3D-BuildCraft-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "3D-BuildCraft-$pkgver"
  install -Dm755 target/release/buildcraft3d "$pkgdir/usr/bin/buildcraft3d"
  install -Dm644 "packaging/flatpak/$_id.desktop" "$pkgdir/usr/share/applications/$_id.desktop"
  install -Dm644 "packaging/flatpak/$_id.metainfo.xml" "$pkgdir/usr/share/metainfo/$_id.metainfo.xml"
  install -Dm644 packaging/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/$_id.svg"
  install -Dm644 packaging/icon.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/$_id.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
